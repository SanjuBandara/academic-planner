# ============================================================================
# Academic Planner Backend - Environment Template (.env.example)
# Copy this file to '.env' and fill in your local environment values.
# ============================================================================

# Database Connection (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/academic_planner
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Application Server
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
