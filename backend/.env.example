# ============================================================================
# Academic Planner Backend - Environment Template (.env.example)
# Copy this file to '.env' and fill in your local environment values.
# ============================================================================

# Database Connection (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/academic_planner
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Application Server
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# AI Planning Assistant
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

